{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "daytasks",
  "version": "0.1.0",
  "identifier": "com.mismiler.daytasks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "daytasks",
        "width": 900,
        "height": 700,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/light/32x32.png",
      "icons/light/128x128.png",
      "icons/light/128x128@2x.png",
      "icons/light/icon.ico"
    ]
  }
}
